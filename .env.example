NODE_ENV=development
# Use a free port (8080 is often taken by other tools e.g. Oracle listener)
PORT=8787

# Local dev: docker compose up -d → then use:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/vouchtails?schema=public
#
# Supabase hosted Postgres alternative:
# DATABASE_URL=postgresql://postgres:<URL_ENCODED_DB_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Omit in dev — derived from SUPABASE_URL unless you override:
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Required in production. In development, placeholders are applied if omitted.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

INTERNAL_PAYOUT_TOKEN=change_this
CORS_ORIGIN=http://localhost:3000
